# ============================================
# Medusa v2 Backend - Environment Variables
# ============================================
# INSTRUCTIONS:
# 1. Copy this file to .env
# 2. Fill in all required values (marked with <REQUIRED>)
# 3. Generate secrets using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 4. NEVER commit .env to git (already in .gitignore)
# ============================================

# ============================================
# DATABASE (Supabase Postgres)
# ============================================
# Get from: Supabase Dashboard > Project Settings > Database > Connection String
# Format: postgresql://postgres:[YOUR-PASSWORD]@[HOST]:[PORT]/postgres
# IMPORTANT: Use "Session" pooler for runtime (recommended)
DATABASE_URL=<REQUIRED>

# Optional: Database name (usually 'postgres' for Supabase)
DB_NAME=postgres

# ============================================
# REDIS (Docker Container)
# ============================================
# For Docker: use service name 'redis'
# For local dev (no Docker): use 'localhost'
REDIS_URL=redis://redis:6379

# ============================================
# CORS CONFIGURATION
# ============================================
# STORE_CORS: Allowed origins for storefront API calls
# Include: Vercel domain, localhost for dev
# Format: comma-separated, no spaces
STORE_CORS=http://localhost:3000,http://localhost:8000,https://your-vercel-app.vercel.app,https://yourdomain.com

# ADMIN_CORS: Allowed origins for admin UI
# Include: backend URL, tunnel URL, localhost
ADMIN_CORS=http://localhost:9000,http://localhost:5173,https://your-tunnel.trycloudflare.com

# AUTH_CORS: Allowed origins for authentication
# Usually same as ADMIN_CORS
AUTH_CORS=http://localhost:9000,http://localhost:5173,https://your-tunnel.trycloudflare.com

# ============================================
# SECURITY SECRETS
# ============================================
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IMPORTANT: Use different values for each secret
# IMPORTANT: Keep these secret and never commit to git

# JWT Secret (for API tokens)
JWT_SECRET=<REQUIRED - 64+ character random string>

# Cookie Secret (for session cookies)
COOKIE_SECRET=<REQUIRED - 64+ character random string>

# ============================================
# CLOUDFLARE R2 STORAGE (Optional)
# ============================================
# Get from: Cloudflare Dashboard > R2 > Manage R2 API Tokens
# If not using R2, leave empty (will use local storage)

S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_BUCKET=sixthgear-media
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_FILE_URL=https://cdn.sixthgearmoto.com
