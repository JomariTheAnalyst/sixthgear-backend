# ============================================
# Medusa Backend - Docker Environment Variables
# ============================================
# INSTRUCTIONS:
# 1. Copy this file to .env in sixthgear-backend folder
# 2. Fill in all required values (marked with <REQUIRED>)
# 3. Generate secrets using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 4. NEVER commit .env to git
# ============================================

# ============================================
# DATABASE (External Supabase Postgres)
# ============================================
# Get from: Supabase Dashboard > Project Settings > Database > Connection String
# Format: postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres
# IMPORTANT: Use "Session" pooler for runtime
DATABASE_URL=<REQUIRED>

# ============================================
# REDIS (Docker Container)
# ============================================
# For Docker: use service name 'redis'
# This is automatically set in docker-compose.yml
REDIS_URL=redis://redis:6379

# ============================================
# CORS CONFIGURATION
# ============================================
# STORE_CORS: Allowed origins for storefront API calls
# Include: Vercel domain, localhost for dev, Cloudflared tunnel
STORE_CORS=http://localhost:3000,http://localhost:8000,https://yourapp.vercel.app,https://your-tunnel.trycloudflare.com

# ADMIN_CORS: Allowed origins for admin UI
# Include: backend URL, tunnel URL, localhost
ADMIN_CORS=http://localhost:9000,http://localhost:5173,https://your-medusa-tunnel.trycloudflare.com

# AUTH_CORS: Allowed origins for authentication
# Usually same as ADMIN_CORS
AUTH_CORS=http://localhost:9000,http://localhost:5173,https://your-medusa-tunnel.trycloudflare.com

# ============================================
# SECURITY SECRETS
# ============================================
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IMPORTANT: Use different values for each secret

# JWT Secret (for API tokens)
JWT_SECRET=<REQUIRED - 64+ character random string>

# Cookie Secret (for session cookies)
COOKIE_SECRET=<REQUIRED - 64+ character random string>

# Cookie settings for local development
COOKIE_SECURE=false

# ============================================
# CLOUDFLARE R2 STORAGE (Optional)
# ============================================
# Get from: Cloudflare Dashboard > R2 > Manage R2 API Tokens
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_BUCKET=sixthgear-media
S3_ENDPOINT=
S3_FILE_URL=
