{
  "name": "sixthgear",
  "version": "0.0.1",
  "description": "A starter for Medusa projects.",
  "author": "Medusa (https://medusajs.com)",
  "license": "MIT",
  "keywords": [
    "sqlite",
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "scripts": {
    "build": "medusa build",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "start": "medusa start",
    "dev": "medusa develop",
    "dev:email": "email dev --dir ./src/modules/resend/emails",
    "render:build": "pnpm install && pnpm run build",
    "render:start": "pnpm run build && pnpm start",
    "configure:meilisearch": "tsx scripts/configure-meilisearch.ts",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@medusajs/admin-sdk": "2.12.4",
    "@medusajs/cli": "2.12.4",
    "@medusajs/framework": "2.12.4",
    "@medusajs/medusa": "2.12.4",
    "@medusajs/payment-stripe": "^2.12.4",
    "@react-email/components": "1.0.1",
    "@rokmohar/medusa-payment-manual": "^1.0.3",
    "meilisearch": "^0.55.0",
    "resend": "^6.5.2",
    "stripe": "^17.5.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@medusajs/admin-shared": "2.12.4",
    "@medusajs/dashboard": "2.12.4",
    "@medusajs/draft-order": "2.12.4",
    "@medusajs/icons": "2.12.4",
    "@medusajs/js-sdk": "^2.13.1",
    "@medusajs/test-utils": "2.12.4",
    "@medusajs/ui": "^4.0.2",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@tanstack/react-query": "^5.90.21",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.12.11",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "@types/uuid": "^9.0.8",
    "jest": "^29.7.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-email": "^4.0.7",
    "react-router-dom": "^6.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.14",
    "yalc": "^1.0.0-pre.53"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.15.0+sha512.486ebc259d3e999a4e8691ce03b5cac4a71cbeca39372a9b762cb500cfdf0873e2cb16abe3d951b1ee2cf012503f027b98b6584e4df22524e0c7450d9ec7aa7b"
}
