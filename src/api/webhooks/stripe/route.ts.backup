import type { MedusaRequest, MedusaResponse } from "@medusajs/framework/http";
import Stripe from "stripe";

/**
 * Stripe Webhook Handler
 *
 * Handles webhook events from Stripe for payment status updates
 *
 * Events handled:
 * - payment_intent.succeeded: Payment completed successfully - creates order
 * - payment_intent.payment_failed: Payment failed
 * - charge.refunded: Refund processed
 *
 * Security: Verifies webhook signature using STRIPE_WEBHOOK_SECRET
 */
export async function POST(
  req: MedusaRequest,
  res: MedusaResponse,
): Promise<void> {
  const stripe = new Stripe(process.env.STRIPE_API_KEY!, {
    apiVersion: "2024-12-18.acacia",
  });

  const webhookSecret = process.env.STRIPE_WEBHOOK_SECRET;

  if (!webhookSecret) {
    console.error("[Stripe Webhook] STRIPE_WEBHOOK_SECRET not configured");
    res.status(500).json({ error: "Webhook secret not configured" });
    return;
  }

  // Get the signature from headers
  const signature = req.headers["stripe-signature"];

  if (!signature) {
    console.error("[Stripe Webhook] No signature provided");
    res.status(400).json({ error: "No signature provided" });
    return;
  }

  let event: Stripe.Event;

  try {
    // Verify webhook signature
    const rawBody = await getRawBody(req);
    event = stripe.webhooks.constructEvent(
      rawBody,
      signature as string,
      webhookSecret,
    );

    console.log(`[Stripe Webhook] Verified event: ${event.type}`);
  } catch (err: any) {
    console.error(
      "[Stripe Webhook] Signature verification failed:",
      err.message,
    );
    res
      .status(400)
      .json({ error: `Webhook signature verification failed: ${err.message}` });
    return;
  }

  // Handle the event
  try {
    switch (event.type) {
      case "payment_intent.succeeded": {
        const paymentIntent = event.data.object as Stripe.PaymentIntent;
        console.log(`[Stripe Webhook] Payment succeeded: ${paymentIntent.id}`);
        console.log(
          `[Stripe Webhook] Amount: ${paymentIntent.amount} ${paymentIntent.currency}`,
        );
        console.log(`[Stripe Webhook] Metadata:`, paymentIntent.metadata);

        // Get cart ID from metadata
        const cartId = paymentIntent.metadata?.cart_id;

        if (!cartId) {
          console.error(
            "[Stripe Webhook] No cart_id in payment metadata - cannot create order",
          );
          break;
        }

        console.log(`[Stripe Webhook] Creating order for cart: ${cartId}`);

        try {
          // Use Medusa's cart module service to complete the cart
          const cartModuleService = req.scope.resolve("cartModuleService");

          // Retrieve the cart first to check if it's already completed
          const cart = await cartModuleService.retrieve(cartId);

          if (cart.completed_at) {
            console.log(
              `[Stripe Webhook] Cart ${cartId} already completed. Order may already exist.`,
            );
            break;
          }

          // Complete the cart using the workflow
          const { completeCartWorkflow } = await import("@medusajs/core-flows");

          const { result, errors } = await completeCartWorkflow(req.scope).run({
            input: {
              id: cartId,
            },
          });

          if (errors && errors.length > 0) {
            console.error(
              "[Stripe Webhook] Workflow errors:",
              JSON.stringify(errors, null, 2),
            );
            throw new Error(`Workflow failed: ${errors[0].error.message}`);
          }

          if (result && result.type === "order") {
            console.log(
              `[Stripe Webhook] ✅ Order created successfully: ${result.order.id}`,
            );
            console.log(
              `[Stripe Webhook] Order total: ${result.order.total} ${result.order.currency_code}`,
            );
            console.log(
              `[Stripe Webhook] Customer email: ${result.order.email}`,
            );
          } else {
            console.error(
              "[Stripe Webhook] Cart completion did not return an order",
            );
            console.error("[Stripe Webhook] Result:", JSON.stringify(result));
          }
        } catch (orderError: any) {
          console.error(
            "[Stripe Webhook] Failed to create order:",
            orderError.message,
          );
          console.error("[Stripe Webhook] Error stack:", orderError.stack);

          // Don't fail the webhook - Stripe will retry
          // Log the error for manual intervention
          console.error(
            `[Stripe Webhook] ⚠️ MANUAL ACTION REQUIRED: Create order for cart ${cartId} with payment ${paymentIntent.id}`,
          );
        }

        break;
      }

      case "payment_intent.payment_failed": {
        const paymentIntent = event.data.object as Stripe.PaymentIntent;
        console.error(`[Stripe Webhook] Payment failed: ${paymentIntent.id}`);
        console.error(
          `[Stripe Webhook] Failure reason:`,
          paymentIntent.last_payment_error,
        );
        break;
      }

      case "charge.refunded": {
        const charge = event.data.object as Stripe.Charge;
        console.log(`[Stripe Webhook] Charge refunded: ${charge.id}`);
        console.log(
          `[Stripe Webhook] Refund amount: ${charge.amount_refunded}`,
        );
        break;
      }

      default:
        console.log(`[Stripe Webhook] Unhandled event type: ${event.type}`);
    }

    // Return 200 to acknowledge receipt
    res.status(200).json({ received: true });
  } catch (err: any) {
    console.error("[Stripe Webhook] Error processing event:", err);
    res.status(500).json({ error: "Webhook processing failed" });
  }
}

/**
 * Get raw body from request for signature verification
 * Stripe requires the raw body to verify the signature
 */
async function getRawBody(req: MedusaRequest): Promise<string> {
  return new Promise((resolve, reject) => {
    let data = "";

    req.on("data", (chunk) => {
      data += chunk;
    });

    req.on("end", () => {
      resolve(data);
    });

    req.on("error", (err) => {
      reject(err);
    });
  });
}
